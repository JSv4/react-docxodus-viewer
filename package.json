{
  "name": "react-docxodus-viewer",
  "version": "0.8.0",
  "description": "React DOCX viewing, review, comparison, editing sessions, history and export powered by Docxodus 12.6.2",
  "type": "module",
  "main": "./dist/react-docxodus-viewer.es.js",
  "module": "./dist/react-docxodus-viewer.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/react-docxodus-viewer.es.js"
    },
    "./styles.css": "./dist/react-docxodus-viewer.css",
    "./viewer": {
      "types": "./dist/types/viewer.d.ts",
      "import": "./dist/viewer.es.js"
    },
    "./editor": {
      "types": "./dist/types/editor.d.ts",
      "import": "./dist/editor.es.js"
    },
    "./engine": {
      "types": "./dist/types/engine.d.ts",
      "import": "./dist/engine.es.js"
    },
    "./worker": {
      "types": "./dist/types/worker.d.ts",
      "import": "./dist/worker.es.js"
    },
    "./export-browser": {
      "types": "./dist/types/export-browser.d.ts",
      "import": "./dist/export-browser.es.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.es.js"
    },
    "./assets": {
      "types": "./scripts/copy-runtime.d.mts",
      "import": "./scripts/copy-runtime.mjs"
    }
  },
  "files": [
    "dist",
    "scripts/copy-runtime.mjs",
    "scripts/copy-runtime.d.mts",
    "scripts/copy-runtime-cli.mjs",
    "docs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "BUILD_LIB=true vite build && tsc -p tsconfig.lib.json",
    "build:demo": "npm run sync:wasm && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib",
    "sync:wasm": "node scripts/sync-wasm.mjs",
    "predev": "npm run sync:wasm",
    "test:browser": "playwright test",
    "check:api": "node scripts/check-api.mjs && node scripts/generate-cooperative-pagination.mjs --check",
    "test:pdf": "node --test tests/node/export.test.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:api",
    "test:package": "npm run build:lib && node scripts/check-package.mjs",
    "test:stress": "node scripts/stress-editor.mjs",
    "test:performance": "node scripts/stress-editor.mjs --benchmark",
    "test:latency": "node scripts/benchmark-latency.mjs",
    "test:latency:native": "node scripts/benchmark-native-transactions.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JSv4/react-docxodus-viewer"
  },
  "homepage": "https://github.com/JSv4/react-docxodus-viewer#readme",
  "bugs": {
    "url": "https://github.com/JSv4/react-docxodus-viewer/issues"
  },
  "keywords": [
    "react",
    "docx",
    "viewer",
    "word",
    "document",
    "office",
    "docxodus"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "docxodus": "12.6.2",
    "react": ">=18",
    "@docxodus/export": "12.6.2"
  },
  "devDependencies": {
    "@docxodus/export": "12.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "docxodus": "12.6.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@docxodus/export": {
      "optional": true
    }
  },
  "bin": {
    "rdv-copy-runtime": "./scripts/copy-runtime-cli.mjs"
  }
}
